{
  "_comment": "Copy to dbt_databricks_job.json (or put the same JSON in env DBT_DATABRICKS_JOB_CONFIG) and set DBT_EXECUTION_MODE=databricks_job. Only used by DBT_DATABRICKS_PIPELINE. Replace every <placeholder>.",

  "git_source": {
    "git_url": "https://github.com/<org>/<repo>",
    "git_provider": "gitHub",
    "git_branch": "main"
  },

  "project_directory": "astro_datautility/dags/dbt/dbt_databricks",
  "profiles_directory": null,

  "warehouse_id": null,

  "job_cluster": {
    "spark_version": "15.4.x-scala2.12",
    "node_type_id": "<node-type, e.g. Standard_DS3_v2>",
    "num_workers": 0,
    "data_security_mode": "SINGLE_USER",
    "spark_conf": {
      "spark.databricks.cluster.profile": "singleNode",
      "spark.master": "local[*, 4]"
    },
    "custom_tags": { "ResourceClass": "SingleNode" }
  },

  "spark_env_vars": {},

  "secret_env_vars": {
    "DATABRICKS_TOKEN": "{{secrets/<scope>/<dbt-token-key>}}",
    "DATABRICKS_HOST": "<workspace-host-without-scheme>",
    "DATABRICKS_HTTP_PATH": "/sql/1.0/warehouses/<warehouse-id>"
  },

  "dbt_pip_spec": "dbt-databricks>=1.7.17,<1.8",
  "timeout_seconds": 21600,
  "polling_period_seconds": 30
}
